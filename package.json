{
  "name": "@withwiz/blog-core",
  "version": "0.1.0",
  "description": "Reusable blog/news core package for Next.js projects",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.mjs",
      "require": "./dist/services/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.mjs",
      "require": "./dist/routes/index.js"
    },
    "./routes/scheduler": {
      "types": "./dist/routes/scheduler-routes.d.ts",
      "import": "./dist/routes/scheduler-routes.mjs",
      "require": "./dist/routes/scheduler-routes.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.mjs",
      "require": "./dist/validators/index.js"
    },
    "./components/admin": {
      "types": "./dist/components/admin/index.d.ts",
      "import": "./dist/components/admin/index.mjs",
      "require": "./dist/components/admin/index.js"
    },
    "./components/public": {
      "types": "./dist/components/public/index.d.ts",
      "import": "./dist/components/public/index.mjs",
      "require": "./dist/components/public/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.mjs",
      "require": "./dist/presets/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.mjs",
      "require": "./dist/seo/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.mjs",
      "require": "./dist/i18n/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.mjs",
      "require": "./dist/errors/index.js"
    },
    "./styles/public": "./dist/styles/blog-public.css",
    "./styles/admin": "./dist/styles/blog-admin.css",
    "./styles/block-editor": "./dist/styles/blog-block-editor.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist",
    "prisma",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "slugify": "^1.6.6"
  },
  "peerDependencies": {
    "@prisma/client": ">=5",
    "@withwiz/block-editor": "^0.1.5",
    "isomorphic-dompurify": ">=2",
    "next": ">=14",
    "react": ">=18",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "@withwiz/block-editor": {
      "optional": true
    },
    "isomorphic-dompurify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@withwiz/block-editor": "^0.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
